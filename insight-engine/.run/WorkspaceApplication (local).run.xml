<component name="ProjectRunConfigurationManager">
  <!--
    IDEA 共享运行配置（提交入库）：
      作用：把 local profile 固化，避免「直接点 main 绿三角 → profile 未激活 → 占位符未解析」的启动失败。
      前置：src/main/resources/application-local.yml 已存在（该文件被 .gitignore 忽略，各人本地自行维护）。
      端口：7102；依赖 UMS(7101) 的网络连通性无要求，但登录态/黑名单与其共享 Redis 键。
      注意：本文件只写 profile 名，不含任何口令（AGENTS.md 铁律 5 / DEVGUIDE P19）。
  -->
  <configuration default="false" name="WorkspaceApplication (local)" type="SpringBootApplicationConfigurationType" factoryName="Spring Boot">
    <module name="insight-engine-workspace" />
    <option name="SPRING_BOOT_MAIN_CLASS" value="com.insightengine.workspace.WorkspaceApplication" />
    <option name="ACTIVE_PROFILES" value="local" />
    <method v="2">
      <option name="Make" enabled="true" />
    </method>
  </configuration>
</component>

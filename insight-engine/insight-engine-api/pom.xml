<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>com.insightengine</groupId>
        <artifactId>insight-engine</artifactId>
        <version>1.0.0-SNAPSHOT</version>
    </parent>

    <!--
      insight-engine-api：跨服务契约模块
      职责（TD §3.1 / §3.2）：
        1. 定义 OpenFeign 客户端接口（@FeignClient），服务间调用统一走这里
        2. 定义共享 DTO（请求/响应对象），供服务提供方与消费方共同引用
      约束：
        - 依赖 common（DTO 复用 Result/PageResult 等基础结构）
        - 不依赖任何业务模块，避免服务间直接耦合
        - 服务之间只能通过本模块的 Feign 接口调用，禁止直接引对方 module 内部类
    -->
    <artifactId>insight-engine-api</artifactId>
    <packaging>jar</packaging>

    <name>insight-engine-api</name>
    <description>智擎 AI 跨服务契约模块（Feign 接口 + 共享 DTO）</description>

    <dependencies>
        <!-- 依赖 common，复用 Result / PageResult / ErrorCode 等基础结构 -->
        <dependency>
            <groupId>com.insightengine</groupId>
            <artifactId>insight-engine-common</artifactId>
        </dependency>

        <!-- OpenFeign：@FeignClient 注解与声明式调用能力 -->
        <dependency>
            <groupId>org.springframework.cloud</groupId>
            <artifactId>spring-cloud-starter-openfeign</artifactId>
        </dependency>

        <!-- jakarta.validation：DTO 上的 JSR-303 校验注解 -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-validation</artifactId>
        </dependency>

        <!-- Lombok -->
        <dependency>
            <groupId>org.projectlombok</groupId>
            <artifactId>lombok</artifactId>
            <scope>provided</scope>
        </dependency>
    </dependencies>
</project>

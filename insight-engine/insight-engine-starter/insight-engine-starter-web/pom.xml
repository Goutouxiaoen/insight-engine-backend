<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>com.insightengine</groupId>
        <artifactId>insight-engine-starter</artifactId>
        <version>1.0.0-SNAPSHOT</version>
    </parent>

    <!--
      insight-engine-starter-web：Web 起步依赖
      职责（TD §4.3 / §4.4）：
        1. 统一异常处理（GlobalExceptionHandler）
        2. 全链路 TraceID（TraceFilter + MDC）
        3. 用户上下文（UserContext / LoginUser，解析网关下发的明文头）
      依赖约束：starter-web → common（单向）
    -->
    <artifactId>insight-engine-starter-web</artifactId>
    <packaging>jar</packaging>

    <name>insight-engine-starter-web</name>
    <description>智擎 AI Web 起步依赖（统一响应/异常/TraceID/用户上下文）</description>

    <dependencies>
        <!-- 依赖 common，复用 Result / ErrorCode / BizException / 常量 -->
        <dependency>
            <groupId>com.insightengine</groupId>
            <artifactId>insight-engine-common</artifactId>
        </dependency>

        <!-- Spring Web（Servlet 栈）：提供 @RestController、HttpServletRequest 等 -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-web</artifactId>
        </dependency>

        <!-- 参数校验：@Valid / JSR-303，配合全局异常捕获 MethodArgumentNotValidException -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-validation</artifactId>
        </dependency>

        <!-- Hutool：IdUtil 生成 traceId（fastSimpleUUID） -->
        <dependency>
            <groupId>cn.hutool</groupId>
            <artifactId>hutool-core</artifactId>
        </dependency>

        <!-- Slf4j：MDC 存取 traceId -->
        <dependency>
            <groupId>org.slf4j</groupId>
            <artifactId>slf4j-api</artifactId>
        </dependency>

        <!-- Lombok -->
        <dependency>
            <groupId>org.projectlombok</groupId>
            <artifactId>lombok</artifactId>
            <scope>provided</scope>
        </dependency>
    </dependencies>
</project>

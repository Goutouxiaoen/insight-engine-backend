<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>com.insightengine</groupId>
        <artifactId>insight-engine-modules</artifactId>
        <version>1.0.0-SNAPSHOT</version>
    </parent>

    <!--
      insight-engine-model：模型网关服务（阶段 6，宿主端口 7103）
      职责（PRD §9.2 / IF §7，TD §3.2）：
        1. 厂商 / 模型 / 路由策略的接入与配置（平台级目录，2026-09-17 裁决「所有业务方共用」）
        2. 聊天补全（OpenAI 兼容 + SSE 流式）、Embedding、Rerank 的统一出口（ChatAdapter 适配器）
        3. 模型用量计量（写 ie_usage_record，供 billing 阶段消费）
      依赖说明：starter-web（统一响应/异常/TraceID/上下文）
                starter-security（JWT 校验 + 方法级权限；后续 chat 端点为对外统一调用入口）
                starter-mybatis（MP + 逻辑删除 + 审计填充）
                starter-redis（登录态/黑名单实现；后续模型列表缓存与限流计数）
                starter-nacos（服务注册，网关以 lb:// 寻址）
                postgresql（主库驱动）
    -->
    <artifactId>insight-engine-model</artifactId>
    <packaging>jar</packaging>

    <name>insight-engine-model</name>
    <description>智擎 AI 模型网关服务</description>

    <dependencies>
        <dependency>
            <groupId>com.insightengine</groupId>
            <artifactId>insight-engine-starter-web</artifactId>
        </dependency>
        <dependency>
            <groupId>com.insightengine</groupId>
            <artifactId>insight-engine-starter-security</artifactId>
        </dependency>
        <dependency>
            <groupId>com.insightengine</groupId>
            <artifactId>insight-engine-starter-mybatis</artifactId>
        </dependency>
        <dependency>
            <groupId>com.insightengine</groupId>
            <artifactId>insight-engine-starter-redis</artifactId>
        </dependency>
        <!-- Nacos 注册中心/配置中心（服务注册名 insight-engine-model，网关以 lb:// 寻址） -->
        <dependency>
            <groupId>com.insightengine</groupId>
            <artifactId>insight-engine-starter-nacos</artifactId>
        </dependency>
        <!-- PostgreSQL 驱动（版本由 Spring Boot BOM 管理） -->
        <dependency>
            <groupId>org.postgresql</groupId>
            <artifactId>postgresql</artifactId>
            <scope>runtime</scope>
        </dependency>
        <!-- Lombok（编译期注解处理） -->
        <dependency>
            <groupId>org.projectlombok</groupId>
            <artifactId>lombok</artifactId>
            <scope>provided</scope>
        </dependency>
        <!-- Knife4j 在线接口文档（OpenAPI3，版本由 BOM 锁定 4.5.0，TD §2.1） -->
        <dependency>
            <groupId>com.github.xiaoymin</groupId>
            <artifactId>knife4j-openapi3-jakarta-spring-boot-starter</artifactId>
        </dependency>
    </dependencies>

    <build>
        <plugins>
            <!-- 打成可执行 jar（spring-boot-maven-plugin） -->
            <plugin>
                <groupId>org.springframework.boot</groupId>
                <artifactId>spring-boot-maven-plugin</artifactId>
                <configuration>
                    <mainClass>com.insightengine.model.ModelApplication</mainClass>
                </configuration>
                <executions>
                    <execution>
                        <goals>
                            <goal>repackage</goal>
                        </goals>
                    </execution>
                </executions>
            </plugin>
        </plugins>
    </build>
</project>

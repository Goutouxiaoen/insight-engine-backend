<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <!--
      insight-engine-dependencies（BOM）
      职责：
        1. 统一本项目「内部模块」（common / api / starter-*）的版本，业务模块依赖时无需写 version
        2. 统一「三方补充依赖」版本（不在 Spring Boot/Cloud BOM 管理范围内，或需显式锁版）：
           MyBatis-Plus、JJWT、Knife4j、EasyExcel、Hutool、Lombok 等
      说明：
        - packaging=pom，本身不产出 jar，仅供 <scope>import</scope> 引用
        - 版本号全部与 TD §2.1「技术选型与版本锁定」表对齐，严禁跨主版本
    -->
    <groupId>com.insightengine</groupId>
    <artifactId>insight-engine-dependencies</artifactId>
    <version>1.0.0-SNAPSHOT</version>
    <packaging>pom</packaging>

    <name>insight-engine-dependencies</name>
    <description>智擎 AI 统一依赖版本 BOM</description>

    <properties>
        <!-- 内部模块统一版本（供本 BOM 与父 POM 复用） -->
        <revision>1.0.0-SNAPSHOT</revision>

        <!-- 三方补充依赖版本锁定（与 TD §2.1 对齐） -->
        <mybatis-plus.version>3.5.7</mybatis-plus.version>
        <jjwt.version>0.12.5</jjwt.version>
        <knife4j.version>4.5.0</knife4j.version>
        <easyexcel.version>3.3.4</easyexcel.version>
        <hutool.version>5.8.27</hutool.version>
        <lombok.version>1.18.30</lombok.version>
    </properties>

    <dependencyManagement>
        <dependencies>
            <!-- ============ 内部模块（统一版本，业务模块依赖时不写 version） ============ -->
            <dependency>
                <groupId>com.insightengine</groupId>
                <artifactId>insight-engine-common</artifactId>
                <version>${revision}</version>
            </dependency>
            <dependency>
                <groupId>com.insightengine</groupId>
                <artifactId>insight-engine-api</artifactId>
                <version>${revision}</version>
            </dependency>
            <dependency>
                <groupId>com.insightengine</groupId>
                <artifactId>insight-engine-starter-web</artifactId>
                <version>${revision}</version>
            </dependency>
            <dependency>
                <groupId>com.insightengine</groupId>
                <artifactId>insight-engine-starter-mybatis</artifactId>
                <version>${revision}</version>
            </dependency>
            <dependency>
                <groupId>com.insightengine</groupId>
                <artifactId>insight-engine-starter-security</artifactId>
                <version>${revision}</version>
            </dependency>
            <dependency>
                <groupId>com.insightengine</groupId>
                <artifactId>insight-engine-starter-redis</artifactId>
                <version>${revision}</version>
            </dependency>
            <dependency>
                <groupId>com.insightengine</groupId>
                <artifactId>insight-engine-starter-nacos</artifactId>
                <version>${revision}</version>
            </dependency>
            <dependency>
                <groupId>com.insightengine</groupId>
                <artifactId>insight-engine-starter-ai</artifactId>
                <version>${revision}</version>
            </dependency>
            <dependency>
                <groupId>com.insightengine</groupId>
                <artifactId>insight-engine-starter-mq</artifactId>
                <version>${revision}</version>
            </dependency>
            <dependency>
                <groupId>com.insightengine</groupId>
                <artifactId>insight-engine-starter-observability</artifactId>
                <version>${revision}</version>
            </dependency>

            <!-- ============ ORM：MyBatis-Plus ============ -->
            <dependency>
                <groupId>com.baomidou</groupId>
                <artifactId>mybatis-plus-spring-boot3-starter</artifactId>
                <version>${mybatis-plus.version}</version>
            </dependency>

            <!-- ============ 鉴权：JJWT ============ -->
            <dependency>
                <groupId>io.jsonwebtoken</groupId>
                <artifactId>jjwt-api</artifactId>
                <version>${jjwt.version}</version>
            </dependency>
            <dependency>
                <groupId>io.jsonwebtoken</groupId>
                <artifactId>jjwt-impl</artifactId>
                <version>${jjwt.version}</version>
            </dependency>
            <dependency>
                <groupId>io.jsonwebtoken</groupId>
                <artifactId>jjwt-jackson</artifactId>
                <version>${jjwt.version}</version>
            </dependency>

            <!-- ============ 接口文档：Knife4j ============ -->
            <dependency>
                <groupId>com.github.xiaoymin</groupId>
                <artifactId>knife4j-openapi3-jakarta-spring-boot-starter</artifactId>
                <version>${knife4j.version}</version>
            </dependency>

            <!-- ============ 导出：EasyExcel ============ -->
            <dependency>
                <groupId>com.alibaba</groupId>
                <artifactId>easyexcel</artifactId>
                <version>${easyexcel.version}</version>
            </dependency>

            <!-- ============ 工具：Hutool ============ -->
            <dependency>
                <groupId>cn.hutool</groupId>
                <artifactId>hutool-all</artifactId>
                <version>${hutool.version}</version>
            </dependency>
            <dependency>
                <groupId>cn.hutool</groupId>
                <artifactId>hutool-core</artifactId>
                <version>${hutool.version}</version>
            </dependency>

            <!-- ============ 提效：Lombok ============ -->
            <dependency>
                <groupId>org.projectlombok</groupId>
                <artifactId>lombok</artifactId>
                <version>${lombok.version}</version>
            </dependency>
        </dependencies>
    </dependencyManagement>
</project>
